+/// Owns the bounded thumbnail fetch state for one item. Read-ahead and the
+/// request ceiling apply only to cache misses; cache hits never consume either
+/// network bytes or request attempts.
+final class RemoteVideoStreamingRangeFetcher: @unchecked Sendable {
+    typealias Reader = @Sendable (Int64, Int) async throws -> Data
+
+    private let byteBudget: RemoteVideoStreamingByteBudget
+    private let requestBudget: RemoteVideoStreamingRequestBudget
+    private let rangeCache: RemoteVideoStreamingRangeCache
+
+    init(
+        maximumTransferredBytes: Int,
+        maximumRangeRequests: Int = RemoteVideoStreamingRequestBudget
+            .defaultMaximumRequests,
+        maximumCacheEntries: Int = RemoteVideoStreamingRangeCache
+            .defaultMaximumEntryCount
+    ) {
+        byteBudget = RemoteVideoStreamingByteBudget(
+            maximumBytes: maximumTransferredBytes
+        )
+        requestBudget = RemoteVideoStreamingRequestBudget(
+            maximumRequests: maximumRangeRequests
+        )
+        rangeCache = RemoteVideoStreamingRangeCache(
+            maximumEntryCount: maximumCacheEntries
+        )
+    }
+
+    func data(
+        at offset: Int64,
+        maximumLength: Int,
+        fileSize: Int64,
+        read: Reader
+    ) async throws -> Data {
+        if let cached = rangeCache.data(
+            at: offset,
+            maximumLength: maximumLength
+        ) {
+            return cached
+        }
+        try Task.checkCancellation()
+        guard var networkRange = RemoteVideoStreamingReadPolicy
+            .alignedNetworkRange(
+                requestedOffset: offset,
+                requestedLength: maximumLength,
+                fileSize: fileSize,
+                maximumFetchLength: byteBudget.remainingByteCount
+            ) else {
+            throw RemoteVideoStreamingError.transferLimitReached
+        }
+
+        var reservedBytes = byteBudget.reserve(upTo: networkRange.length)
+        let prefixBytes = Int(offset - networkRange.offset)
+        if reservedBytes <= prefixBytes {
+            byteBudget.complete(
+                reservedBytes: reservedBytes,
+                receivedBytes: 0
+            )
+            guard let fallback = RemoteVideoStreamingReadPolicy
+                .alignedNetworkRange(
+                    requestedOffset: offset,
+                    requestedLength: maximumLength,
+                    fileSize: fileSize,
+                    maximumFetchLength: byteBudget.remainingByteCount
+                ) else {
+                throw RemoteVideoStreamingError.transferLimitReached
+            }
+            networkRange = fallback
+            reservedBytes = byteBudget.reserve(upTo: fallback.length)
+        }
+        guard reservedBytes > 0 else {
+            throw RemoteVideoStreamingError.transferLimitReached
+        }
+        guard requestBudget.claimRequest() else {
+            byteBudget.complete(
+                reservedBytes: reservedBytes,
+                receivedBytes: 0
+            )
+            throw RemoteVideoStreamingError.requestLimitReached
+        }
+
+        let received: Data
+        do {
+            received = try await read(networkRange.offset, reservedBytes)
+            byteBudget.complete(
+                reservedBytes: reservedBytes,
+                receivedBytes: received.count
+            )
+        } catch {
+            byteBudget.complete(
+                reservedBytes: reservedBytes,
+                receivedBytes: 0
+            )
+            throw error
+        }
+        try Task.checkCancellation()
+        guard received.count <= reservedBytes else {
+            throw NasFinderError.invalidResponse
+        }
+        rangeCache.store(received, at: networkRange.offset)
+        guard let result = rangeCache.data(
+            at: offset,
+            maximumLength: maximumLength
+        ) else {
+            throw RemoteVideoStreamingError.unexpectedEndOfFile
+        }
+        return result
     }
+
+    var transferredByteCount: Int { byteBudget.transferredByteCount }
+    var accountedByteCount: Int { byteBudget.accountedByteCount }
+    var requestCount: Int { requestBudget.requestCount }
+    var cachedEntryCount: Int { rangeCache.entryCount }
 }
 
+final class RemoteVideoStreamingRequestBudget: @unchecked Sendable {
+    static let defaultMaximumRequests = 256
+
+    private let maximumRequests: Int
+    private let lock = NSLock()
+    private var claimedRequests = 0
+
+    init(maximumRequests: Int) {
+        self.maximumRequests = max(maximumRequests, 0)
+    }
+
+    func claimRequest() -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        guard claimedRequests < maximumRequests else { return false }
+        claimedRequests += 1
+        return true
+    }
+
+    var requestCount: Int {
+        lock.lock()
+        defer { lock.unlock() }
+        return claimedRequests
+    }
+}
