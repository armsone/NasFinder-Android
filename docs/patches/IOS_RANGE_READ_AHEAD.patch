+    static func alignedNetworkRange(
+        requestedOffset: Int64,
+        requestedLength: Int,
+        fileSize: Int64,
+        maximumFetchLength: Int
+    ) -> NetworkRange? {
+        guard requestedOffset >= 0,
+              requestedOffset < fileSize,
+              requestedLength > 0,
+              maximumFetchLength > 0 else { return nil }
+        let block = Int64(minimumReadAheadBytes)
+        let alignedOffset = requestedOffset - requestedOffset % block
+        let prefixBytes = Int(requestedOffset - alignedOffset)
+        let desiredLength = max(
+            minimumReadAheadBytes,
+            min(boundedChunkBytes, requestedLength + prefixBytes)
+        )
+        let alignedLength = min(
+            desiredLength,
+            maximumFetchLength,
+            Int(min(Int64(Int.max), fileSize - alignedOffset))
+        )
+        if alignedLength > prefixBytes {
+            return NetworkRange(offset: alignedOffset, length: alignedLength)
+        }
+        let fallbackLength = min(
+            max(requestedLength, 1),
+            maximumFetchLength,
+            Int(min(Int64(Int.max), fileSize - requestedOffset))
+        )
+        return fallbackLength > 0
+            ? NetworkRange(offset: requestedOffset, length: fallbackLength)
+            : nil
+    }
+}
