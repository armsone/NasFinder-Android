+private actor FakeStreamingRangeService {
+    struct Request: Equatable {
+        let offset: Int64
+        let length: Int
+    }
+
+    private(set) var requests: [Request] = []
+    private let stalls: Bool
+
+    init(stalls: Bool = false) {
+        self.stalls = stalls
+    }
+
+    func readRange(offset: Int64, length: Int) async throws -> Data {
+        requests.append(Request(offset: offset, length: length))
+        if stalls {
+            try await Task.sleep(for: .seconds(30))
+        }
+        return Data(repeating: UInt8(truncatingIfNeeded: offset), count: length)
+    }
+
+    func waitUntilRequested() async throws {
+        let clock = ContinuousClock()
+        let deadline = clock.now.advanced(by: .seconds(1))
+        while requests.isEmpty, clock.now < deadline {
+            try await Task.sleep(for: .milliseconds(5))
+        }
+        XCTAssertFalse(requests.isEmpty)
+    }
+}
